# Capitalife Terminal - Public Preview / Vercel
NEXT_PUBLIC_APP_MODE=public-preview
NEXT_PUBLIC_RESEARCH_ONLY=true
NEXT_PUBLIC_APP_NAME=Fund Manager Dashboard

# Simple preview access gate. Keep the real value in Vercel, never in client variables.
SIMPLE_GATE_PASSWORD=inno

# Cloud preview must not depend on local Brain or Vault paths.
CAPITALIFE_BRAIN_PATH=
INVORIA_BRIDGE_ENABLED=false
INVORIA_BRIDGE_MODE=readonly
SENTINEL_DEFAULT_PROVIDER=disabled

# Optional AI providers
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Track-record storage and server-only sync
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRACK_RECORD_SYNC_MODE=mock
TRACK_RECORD_SYNC_TOKEN=
TRACK_RECORD_ALLOW_UNAUTHENTICATED_LOCAL=0
VERCEL_STATIC_IPS_ENABLED=false

MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
MYFXBOOK_ACCOUNT_ID=
MYFXBOOK_BROKER_TIMEZONE=

DARWINEX_ACCESS_TOKEN=
DARWINEX_CLIENT_ID=
DARWINEX_CLIENT_SECRET=
DARWINEX_REFRESH_TOKEN=
DARWINEX_PRODUCT_ID=
DARWINEX_TOKEN_URL=
DARWINEX_INFO_URL=
DARWINEX_HISTORY_URL=
DARWINEX_QUOTES_URL=
DARWINEX_INVESTOR_URL=

# Globe overlay layers; all degrade gracefully without credentials.
NASA_FIRMS_KEY=
AIS_API_KEY=
