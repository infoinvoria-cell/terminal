# Capitalife Terminal - Public Preview / Vercel
NEXT_PUBLIC_APP_MODE=public-preview
NEXT_PUBLIC_RESEARCH_ONLY=true
NEXT_PUBLIC_APP_NAME=Fund Manager Dashboard

# Simple preview access gate. Keep the real value in Vercel, never in client variables.
SIMPLE_GATE_PASSWORD=inno

# Cloud preview must not depend on local Brain or Vault paths.
CAPITALIFE_BRAIN_PATH=
INVORIA_BRIDGE_ENABLED=false
INVORIA_BRIDGE_MODE=readonly
SENTINEL_DEFAULT_PROVIDER=disabled

# Optional AI providers (all free-tier only — no paid usage)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Sentinel cloud providers (server-only, never NEXT_PUBLIC_)
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# GitHub token — must have Models access enabled; free-tier only
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=
# Cloudflare Workers AI — requires Account ID and API Token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=
# HuggingFace — free inference only, HF_TOKEN required
HF_TOKEN=
HF_MODEL=

# Track-record storage and server-only sync
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRACK_RECORD_SYNC_MODE=mock
TRACK_RECORD_SYNC_TOKEN=
TRACK_RECORD_ALLOW_UNAUTHENTICATED_LOCAL=0
VERCEL_STATIC_IPS_ENABLED=false

MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
MYFXBOOK_ACCOUNT_ID=
MYFXBOOK_BROKER_TIMEZONE=

# ── ACCOUNT 1 – MT4 ──────────────────────────────────────────────────────────
TRACK_ACCOUNT_1_ENABLED="false"
TRACK_ACCOUNT_1_ID="account_1"
TRACK_ACCOUNT_1_DISPLAY_NAME="Darwinex MT4"
TRACK_ACCOUNT_1_PLATFORM="MT4"
TRACK_ACCOUNT_1_BROKER=""
TRACK_ACCOUNT_1_LOGIN=""
TRACK_ACCOUNT_1_INVESTOR_PASSWORD=""
TRACK_ACCOUNT_1_SERVER=""
TRACK_ACCOUNT_1_TERMINAL_PATH=""
TRACK_ACCOUNT_1_DATA_PATH=""
TRACK_ACCOUNT_1_CURRENCY=""
TRACK_ACCOUNT_1_BROKER_TIMEZONE=""
TRACK_ACCOUNT_1_BRIDGE_MODE="FILE"
TRACK_ACCOUNT_1_BRIDGE_TOKEN=""

# ── ACCOUNT 2 – MT5 ──────────────────────────────────────────────────────────
TRACK_ACCOUNT_2_ENABLED="false"
TRACK_ACCOUNT_2_ID="account_2"
TRACK_ACCOUNT_2_DISPLAY_NAME="Vantage MT5"
TRACK_ACCOUNT_2_PLATFORM="MT5"
TRACK_ACCOUNT_2_BROKER="Vantage"
TRACK_ACCOUNT_2_AUTH_MODE="terminal_session"
TRACK_ACCOUNT_2_LOGIN=""
TRACK_ACCOUNT_2_INVESTOR_PASSWORD=""
TRACK_ACCOUNT_2_SERVER=""
TRACK_ACCOUNT_2_TERMINAL_PATH=""
TRACK_ACCOUNT_2_CURRENCY=""
TRACK_ACCOUNT_2_BROKER_TIMEZONE=""

# ── Myfxbook (optional, nur Kontrolle für Account 2) ─────────────────────────
MYFXBOOK_ENABLED="false"

# ── Track-Record Sync ─────────────────────────────────────────────────────────
TRACK_RECORD_SYNC_ENABLED="false"
TRACK_RECORD_SYNC_INTERVAL_SECONDS="30"
TRACK_RECORD_CRON_SECRET=""
TRACK_RECORD_ENCRYPTION_KEY=""

DARWINEX_ACCESS_TOKEN=
DARWINEX_CLIENT_ID=
DARWINEX_CLIENT_SECRET=
DARWINEX_REFRESH_TOKEN=
DARWINEX_PRODUCT_ID=
DARWINEX_TOKEN_URL=
DARWINEX_INFO_URL=
DARWINEX_HISTORY_URL=
DARWINEX_QUOTES_URL=
DARWINEX_INVESTOR_URL=

# Globe overlay layers; all degrade gracefully without credentials.
NASA_FIRMS_KEY=
AIS_API_KEY=

# MT5 Account 2 connector — local snapshot output path (override if needed)
TRACK_ACCOUNT_2_SNAPSHOT_PATH=".runtime/track-record/account_2-snapshot.json"
